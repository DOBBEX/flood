generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  username String @unique
  password String
  role     String @default("VIEWER") // "ADMIN" or "VIEWER"
}

model AlertLog {
  id        String   @id @default(cuid())
  state     String
  message   String
  recipient String
  status    String   @default("simulated")
  createdAt DateTime @default(now())
}

model Reading {
  id          String   @id @default(cuid())
  distance    Float
  waterValue  Int
  isRaining   Boolean
  state       String
  createdAt   DateTime @default(now())
}

model SystemConfig {
  id                  String @id @default(cuid())
  distWarningCm       Int    @default(50)
  distCriticalCm      Int    @default(25)
  distHysteresisCm    Int    @default(8)
  waterCritThresh     Int    @default(600)
  waterHysteresis     Int    @default(80)
  rainAoThresh        Int    @default(800)
  smsCooldownMs       Int    @default(120000)
  probeDebounceMs     Int    @default(500)
  rainResumeMs        Int    @default(30000)
  idlePollMs          Int    @default(5000)
  monitorPollMs       Int    @default(2000)
  recipientPhone      String @default("+1234567890")
}
